{
  "name": "soft-soft-planet",
  "version": "1.0.0",
  "description": "软软星球 · Slime ASMR 桌面解压小游戏",
  "main": "main.js",
  "author": "Student Project",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.student.softsoftplanet",
    "productName": "软软星球",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "game/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}